                                                           <TR>
                                                             <TD height="45"><div align="center">
                                                               <table width="300" border="0" cellpadding="2" cellspacing="0" summary="table">
                                                                 <tbody>
                                                                   <tr>
                                                                     <td width="100" bgcolor="#FFFFFF"><div align="center"><font color="#333333" size="3">削減額</font></div></td>
                                                    <td width="229" valign="bottom" bgcolor="#FFFFFF" style="font-size : 12pt;"><div align="center"><font color="#FF0000" size="3">約３７万円の削減</font></div></td>
